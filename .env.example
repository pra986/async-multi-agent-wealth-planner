# AWS Core Configuration
AWS_REGION=us-east-1
AWS_SQS_QUEUE_URL=<YOUR_SQS_QUEUE_URL>
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# Aurora PostgreSQL (Data API / Asyncpg)
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:wealth-planner-aurora
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:wealth-planner-db
AURORA_DATABASE=wealth_planner

# S3 Vectors (Semantic Financial Research Store)
S3_VECTORS_BUCKET=wealth-planner-vectors
S3_VECTORS_INDEX=market-research-embeddings

# Clerk Authentication
CLERK_ISSUER=<YOUR_CLERK_ISSUER>
CLERK_JWKS_URL=<YOUR_CLERK_JWKS_URL>

# Runtime Controls
JOB_LOCK_TTL_SECONDS=300
CHART_SUM_TOLERANCE=0.01
